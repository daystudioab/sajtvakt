# Kopiera till .env och fyll i.

# Domänen panelen ska ligga på (DNS: A-post till serverns IP).
SAJTVAKT_DOMAIN=sajtvakt.se
SAJTVAKT_PUBLIC_URL=https://sajtvakt.se

# Lösenord till panelen första gången (minst 12 tecken). Byt sedan i panelen.
SAJTVAKT_ADMIN_PASSWORD=

# E-post för larm (t.ex. kontot från ditt webbhotell, Brevo eller Mailgun).
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Mottagare kan också ändras i panelen under Inställningar.
ALERT_EMAIL=

# Valfritt
SAJTVAKT_TZ=Europe/Stockholm
BACKUP_HOUR=2
RETENTION_DAYS=30
